---
import type CollectionEntryBase from "../types/CollectionEntryBase";

type Props = CollectionEntryBase & {
	link: string;
	totalItemsInSet: number;
	setPos: number;
	dateFormatter: Intl.DateTimeFormat;
};

const { title, blurb, date, category, link } = Astro.props;

const formattedDate = Astro.props.dateFormatter.format(date);
---

<style>
  li {
    display: block;
    width: fit-content;
  }
  li a:not(:hover) {
    text-decoration-color: transparent;
  }
</style>

<li>
  <a href={link}>
    <h4>{title}</h4>
    <p>{blurb}</p>
    <footer>
      <small>
        <time datetime={date?.toISOString()}>{formattedDate}</time> ※ {category}
      </small>
    </footer>
  </a>
</li>
