---
import { Font } from "astro:assets";
import "../styles/reset.css";
import "../styles/global.css";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Dylan Myers"
  href={new URL("feed.rss", Astro.site)}
/>

<Font cssVariable="--font-display" preload />
<Font cssVariable="--font-sans-serif" preload />

<link rel="icon" type="image/png" sizes="96x96" href="/favicon/icon-96.png">
<link rel="icon" href="/favicon/icon.svg" type="image/svg+xml" sizes="any">
<link rel="apple-touch-icon" href="/favicon/icon-180.png">
<link rel="manifest" href="/favicon/site.webmanifest">
<meta name="theme-color" content="#e4e6fc" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#002246" media="(prefers-color-scheme: dark)">
